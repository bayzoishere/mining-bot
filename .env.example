# ═══════════════════════════════════════════════════════
# Mine WorkNet Bot — Environment Config
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════

# ── Wallet ─────────────────────────────────────────
# Your wallet private key (0x...)
# GET THIS FROM YOUR WALLET - NEVER SHARE WITH ANYONE
MINING_WALLET_PRIVATE_KEY=

# ── Datasets ───────────────────────────────────────
# Comma-separated dataset IDs
# Available: ds_wikipedia, ds_arxiv, ds_community
# Example: ds_wikipedia,ds_arxiv
DATASETS=ds_wikipedia,ds_arxiv

# ── Timing ─────────────────────────────────────────
# Loop interval in seconds (default: 60)
INTERVAL=60

# ── Proxy (optional) ────────────────────────────────
# Uncomment and fill if using a proxy
# HTTP_PROXY=http://user:password@proxy.example.com:8080
# HTTPS_PROXY=http://user:password@proxy.example.com:8080

# ── Quality Settings ───────────────────────────────
# Set to "true" for quality over quantity (slower but better)
QUALITY_MODE=true

# ── Clear State ───────────────────────────────────
# Set to "true" to clear stale worker state on start
CLEAR_STATE=false
